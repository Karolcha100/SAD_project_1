fig.width = 10, fig.height = 6)
library(tidyverse)
library(ggplot2)
library(GGally)       # ggpairs (odpowiednik sns.pairplot)
library(patchwork)    # składanie wykresów
library(scales)
library(boot)         # bootstrap
library(nortest)      # anderson.darling.test (lilliefors)
library(corrplot)
df_raw <- read_csv("penguins_lter.csv")
df_raw
df_processed <- df_raw %>%
select(-studyName, -Stage, -Region, -`Sample Number`, -Comments) %>%
drop_na()
df_processed
df_processed <- df_processed %>%
mutate(Species = str_remove(Species, " [Pp]enguin[\\w ()]*"))
df_processed
df_processed <- df_processed %>%
mutate(`Date Egg` = as.Date(`Date Egg`))
df_processed
first_variables <- c("Individual ID", "Species", "Island",
"Clutch Completion", "Sex", "Date Egg")
df <- df_processed %>%
select(all_of(first_variables),
everything()) %>%
filter(Sex != ".")
df
categorical_variables <- c("Species", "Island", "Clutch Completion", "Sex")
numerical_variables <- c(
"Culmen Length (mm)",
"Culmen Depth (mm)",
"Flipper Length (mm)",
"Body Mass (g)",
"Delta 15 N (o/oo)",
"Delta 13 C (o/oo)"
)
for (cat_var in categorical_variables) {
p <- ggpairs(
df %>% select(all_of(numerical_variables), all_of(cat_var)),
aes(color = .data[[cat_var]], alpha = 0.6),
upper = list(continuous = "density"),
lower = list(continuous = "points"),
diag  = list(continuous = "densityDiag")
) +
labs(title = paste("Pairplot względem:", cat_var)) +
theme_minimal()
print(p)
}
# Pomocnicza funkcja: dane do formatu długiego dla wybranych zmiennych
df_long <- df %>%
select(all_of(c(numerical_variables, categorical_variables))) %>%
pivot_longer(cols = all_of(numerical_variables),
names_to = "variable", values_to = "value")
ggplot(df_long, aes(x = value)) +
geom_histogram(bins = 25, fill = "steelblue", color = "white") +
facet_wrap(~variable, scales = "free", ncol = 2) +
theme_minimal() +
theme(panel.grid.minor = element_blank()) +
labs(title = "Histogramy zmiennych ilościowych")
