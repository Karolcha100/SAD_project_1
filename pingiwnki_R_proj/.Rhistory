p <- ggplot(df, aes(x = Species, y = .data[[num_var]], fill = Sex)) +
geom_violin(position = position_dodge(0.8), alpha = 0.7) +
theme_minimal() +
theme(panel.grid.minor = element_blank()) +
labs(title = paste("Violin plot:", num_var, "wg gatunku i płci"))
