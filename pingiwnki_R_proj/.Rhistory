geom_violin(fill = "steelblue", alpha = 0.7) +
facet_wrap(~variable, scales = "free", ncol = 3) +
theme_minimal() +
theme(axis.text.x = element_blank()) +
labs(title = "Wykresy Wiolinowe zmiennych ilościowych")
ggplot(df_long, aes(x = variable, y = value)) +
geom_boxplot(fill = "steelblue", alpha = 0.7) +
facet_wrap(~variable, scales = "free", ncol = 3) +
theme_minimal() +
theme(axis.text.x = element_blank()) +
labs(title = "Box-Ploty zmiennych ilościowych")
ggplot(df_long, aes(x = value, fill = Species)) +
geom_histogram(bins = 25, position = "dodge", alpha = 0.8) +
facet_wrap(~variable, scales = "free", ncol = 2) +
theme_minimal() +
labs(title = "Histogramy wg gatunku (Species)")
ggplot(df_long, aes(x = value, fill = Sex)) +
geom_histogram(bins = 25, position = "dodge", alpha = 0.8) +
facet_wrap(~variable, scales = "free", ncol = 2) +
theme_minimal() +
labs(title = "Histogramy wg płci (Sex)")
ggplot(df_long, aes(x = value, color = Sex)) +
stat_ecdf() +
facet_wrap(~variable, scales = "free", ncol = 2) +
theme_minimal() +
labs(title = "ECDF wg płci")
ggplot(df_long, aes(x = value, color = Species)) +
stat_ecdf() +
facet_wrap(~variable, scales = "free", ncol = 2) +
theme_minimal() +
labs(title = "ECDF wg gatunku")
